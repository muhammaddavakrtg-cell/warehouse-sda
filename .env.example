# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Opsional untuk mode lokal, Wajib untuk production Supabase)
# Isi dengan URL dan Anon Key proyek Supabase Anda untuk mengaktifkan Supabase Auth, Database & Realtime
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
